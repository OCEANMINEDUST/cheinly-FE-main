{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "cheinly-mcp",
      "version": "0.1.0",
      "title": "Cheinly MCP"
    },
    "tools": [
      {
        "name": "list_sellers",
        "title": "List sellers",
        "description": "List every seller and supplier storefront available on Cheinly, including their bio-link username and business type.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List active Cheinly products. Optionally filter by seller username, in-stock only, or a text query on name/description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sellerUsername": {
              "description": "Seller/supplier username (e.g. 'adunni' or 'globalsneakers').",
              "type": "string",
              "minLength": 1
            },
            "inStockOnly": {
              "description": "If true, only return products currently in stock.",
              "type": "boolean"
            },
            "query": {
              "description": "Case-insensitive substring to match against name and description.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "description": "Maximum number of products to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Fetch a single Cheinly product by its product ID (e.g. 'PRD_83921').",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "minLength": 1,
              "description": "Product ID such as 'PRD_83921'."
            }
          },
          "required": [
            "productId"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
